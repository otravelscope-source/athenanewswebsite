# For local use. Production is configured by Docker Compose below.
SITE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
NODE_ENV=development
# Production: your registered domain with DNS pointed at your server.
# DOMAIN=news.example.com

# Google Search Console URL-prefix verification: the content value from its HTML tag.
# GOOGLE_SITE_VERIFICATION=your_google_verification_token
# Optional additional old hostnames that should redirect to SITE_URL (comma separated).
# CANONICAL_HOST_ALIASES=old-domain.example

# Set the key in your host's secret variables, never commit it.
# NEWSLETTER_FROM must be an address on your verified sending domain.
NEWSLETTER_ENABLED=false
# RESEND_API_KEY=
# NEWSLETTER_FROM=ATHENA <news@your-owned-domain.example>
NEWSLETTER_REPLY_TO=otravelscope@gmail.com

